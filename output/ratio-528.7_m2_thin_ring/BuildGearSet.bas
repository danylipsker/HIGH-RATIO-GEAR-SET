Attribute VB_Name = "BuildGearSet"
' =============================================================================
'  BuildGearSet.bas  -  3K compound planetary reducer (single planet, floating thin ring)
'
'  Generated by gearset.py for the set "ratio-528.7_m2_thin_ring"  -  ratio -1560695/2952 = -528.690718
'
'  Creates native, re-generatable SolidWorks parts and an assembly:
'     Sun.SLDPRT           Zs = 16   (input, with shaft)
'     Planet.SLDPRT        Zp = 32   (one planet on the carrier pin)
'     ThinRing.SLDPRT      Zr1 = 115 internal / Zr2 = 123 external teeth, orbits with eccentricity e
'     Carrier.SLDPRT       eccentric journal + planet pin (idle)
'     FixedRing.SLDPRT     Zf = 158   (housing, grounded)
'     OutputRing.SLDPRT    Zo = 155   (output)
'     GearSet.SLDASM       everything placed so that all teeth mesh
'
'  How to use
'    1. SolidWorks: Tools > Macro > New...  save e.g. BuildGearSet.swp
'    2. VBA editor: File > Import File...  choose this .bas (delete the empty module if you like)
'    3. Check OUT_DIR below (folder is created if missing) and run  Main  (F5).
'       Building ~150 teeth per ring takes a minute or two.
'    4. To change the ratio / module / size: re-run  gearset.py  which rewrites this file,
'       then re-run Main. Tooth counts, module, pressure angle, profile shift, face width,
'       clearances and all positions live in the parameter block below (true involutes are
'       computed here, so you may also edit the block by hand and re-run).
'
'  Notes
'    * Written for SolidWorks 2014+ (FeatureExtrusion3, AddComponent5, CreateSpline2).
'      Written without a SolidWorks seat at hand: if a call fails, the error message names
'      the step; check the API help for your version's exact signature.
'    * All API lengths are metres; the parameters below are millimetres / degrees.
'    * The macro calibrates the extrude / offset / arc direction conventions on a
'      throw-away part first, so stacking along Z comes out right on any installation.
'    * Parts are inserted into the assembly at their computed positions (fixed ring is fixed).
'      Add concentric / gear mates if you want to animate it.
' =============================================================================
Option Explicit

' ----------------------------------------------------------------------------- parameters
Const OUT_DIR As String = "C:\Users\Dany\source\claudecode\HIGH-RATIO-GEAR-SET\output\ratio-528.7_m2_thin_ring"
Const SET_NAME As String = "ratio-528.7_m2_thin_ring"

Const MODULE_MM As Double = 2.0          ' module
Const ALPHA_DEG As Double = 20.0       ' pressure angle
Const ADDENDUM As Double = 1#                   ' ha*  (modules)
Const CLEARANCE As Double = 0.25                ' c*   (modules)

Const ZS As Long = 16                       ' sun
Const ZP As Long = 32                       ' planet
Const ZR1 As Long = 115                     ' thin ring, internal teeth
Const ZR2 As Long = 123                     ' thin ring, external teeth
Const ZF As Long = 158                       ' fixed ring
Const ZO As Long = 155                       ' output ring
Const X_FIXED As Double = 0.0           ' profile shift coefficient, fixed ring
Const X_OUTPUT As Double = 1.913285752         ' profile shift coefficient, output ring

Const FACE_WIDTH As Double = 20.0     ' mm, one mesh section (A: sun/planet/fixed ring, B: output ring)
Const GAP As Double = 3.0                   ' mm, axial gap between the sections
Const RING_OUTER_R As Double = 171.326571504 ' mm, fixed and output ring outer radius
Const JOURNAL_R As Double = 117.35       ' mm, carrier journal (runs in the thin ring bore)
Const SHAFT_R As Double = 8.0           ' mm, sun shaft radius
Const PIN_R As Double = 14.4               ' mm, planet pin radius
Const FIT_CLEARANCE As Double = 0.15 ' mm, radial clearance pin/bore and shaft/bore
Const N_HOLES As Long = 6             ' flange holes in the rings
Const HOLE_D As Double = 4.0             ' mm
Const HOLE_CIRCLE_R As Double = 166.326571504 ' mm
Const SHAFT_IN As Double = 40.0         ' mm, input stub before z = 0
Const SHAFT_OUT As Double = 20.0       ' mm, stub behind the carrier

Const A1 As Double = 48.0                     ' mm, sun - planet centre distance  (planet at +x)
Const ECC As Double = 35.0                   ' mm, thin ring eccentricity         (thin ring centre at -x)

' first tooth centre angles (degrees) so that every mesh is in contact at the assembly position
Const PH_SUN As Double = 0.0
Const PH_PLANET As Double = 5.625
Const PH_TINT As Double = 0.0
Const PH_TEXT As Double = 0.0
Const PH_FIXED As Double = -0.0
Const PH_OUTPUT As Double = 1.161290323

Const N_FLANK As Long = 12                      ' spline points per flank
Const PI As Double = 3.14159265358979

' ----------------------------------------------------------------------------- globals
Dim swApp As SldWorks.SldWorks
Dim gDirFlip As Boolean       ' pass to FeatureExtrusion3 so that extrusions grow towards +Z
Dim gOffFlip As Boolean       ' pass as FlipStartOffset so that the start offset is towards +Z
Dim gArcCCW As Long           ' CreateArc direction value that produces a counter-clockwise arc
Dim gStep As String
Dim gPartPaths As Collection

' ============================================================================= main
Sub Main()
    On Error GoTo fail
    gStep = "connect"
    Set swApp = Application.SldWorks
    Set gPartPaths = New Collection
    EnsureFolder OUT_DIR

    gStep = "calibrate directions"
    Calibrate

    Dim zA0 As Double, zA1 As Double, zB0 As Double, zB1 As Double
    zA0 = 0: zA1 = FACE_WIDTH: zB0 = FACE_WIDTH + GAP: zB1 = 2 * FACE_WIDTH + GAP

    gStep = "fixed ring": BuildFixedRing zA0, zA1
    gStep = "output ring": BuildOutputRing zB0, zB1
    gStep = "sun": BuildSun zA0, zA1, zB1
    gStep = "planet": BuildPlanet zA0, zA1
    gStep = "thin ring": BuildThinRing zA0, zA1, zB1
    gStep = "carrier": BuildCarrier zA1, zB0, zB1
    gStep = "assembly": BuildAssembly

    MsgBox "Gear set " & SET_NAME & " built in" & vbCrLf & OUT_DIR & vbCrLf & vbCrLf & _
           "ratio " & "-1560695/2952 = -528.690718", vbInformation
    Exit Sub
fail:
    MsgBox "BuildGearSet failed at step '" & gStep & "':" & vbCrLf & Err.Description, vbCritical
End Sub

' ============================================================================= parts
Private Sub BuildSun(z0 As Double, z1 As Double, zEnd As Double)
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    StartSketch swModel
    AddExternalOutline swModel, ZS, 0#, PH_SUN, 0#, 0#
    Extrude swModel, z1 - z0, z0, False
    ' shaft: forward through the carrier, plus an input stub behind z = 0
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, SHAFT_R / 1000
    Extrude swModel, zEnd + SHAFT_OUT, 0, False
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, SHAFT_R / 1000
    Extrude swModel, SHAFT_IN, 0, True
    Finish swModel, "Sun", ZS, 0#
End Sub

Private Sub BuildPlanet(z0 As Double, z1 As Double)
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    StartSketch swModel
    AddExternalOutline swModel, ZP, 0#, PH_PLANET, 0#, 0#
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, (PIN_R + FIT_CLEARANCE) / 1000
    Extrude swModel, z1 - z0, z0, False
    Finish swModel, "Planet", ZP, 0#
End Sub

Private Sub BuildThinRing(z0 As Double, z1 As Double, zEnd As Double)
    ' part origin = thin ring centre. External teeth over the full length,
    ' internal teeth in section A only, plain bore (root radius) in section B for the carrier journal.
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    Dim rfInt As Double
    rfInt = RootRadiusInternal(ZR1, 0#)
    StartSketch swModel
    AddExternalOutline swModel, ZR2, 0#, PH_TEXT, 0#, 0#
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, rfInt / 1000
    Extrude swModel, zEnd - z0, z0, False
    StartSketch swModel
    AddInternalOutline swModel, ZR1, 0#, PH_TINT, 0#, 0#
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, (rfInt + 0.05 * MODULE_MM) / 1000
    Extrude swModel, z1 - z0, z0, False
    Finish swModel, "ThinRing", ZR1, 0#
End Sub

Private Sub BuildCarrier(zA1 As Double, zB0 As Double, zB1 As Double)
    ' part origin = sun axis. Journal centred at (-e, 0) in section B, bore for the sun shaft,
    ' planet pin at (a1, 0) reaching through the gap into section A.
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius -ECC / 1000, 0, 0, JOURNAL_R / 1000
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, (SHAFT_R + FIT_CLEARANCE) / 1000
    Extrude swModel, zB1 - zB0, zB0, False
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius A1 / 1000, 0, 0, PIN_R / 1000
    Extrude swModel, zB0 + 0.5 * (zB1 - zB0), 0, False
    Finish swModel, "Carrier", 0, 0#
End Sub

Private Sub BuildFixedRing(z0 As Double, z1 As Double)
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, RING_OUTER_R / 1000
    AddInternalOutline swModel, ZF, X_FIXED, PH_FIXED, 0#, 0#
    AddHoles swModel
    Extrude swModel, z1 - z0, z0, False
    Finish swModel, "FixedRing", ZF, X_FIXED
End Sub

Private Sub BuildOutputRing(z0 As Double, z1 As Double)
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, RING_OUTER_R / 1000
    AddInternalOutline swModel, ZO, X_OUTPUT, PH_OUTPUT, 0#, 0#
    AddHoles swModel
    Extrude swModel, z1 - z0, z0, False
    Finish swModel, "OutputRing", ZO, X_OUTPUT
End Sub

Private Sub AddHoles(swModel As SldWorks.ModelDoc2)
    Dim k As Long, t As Double
    For k = 0 To N_HOLES - 1
        t = 2 * PI * (k + 0.5) / N_HOLES
        swModel.SketchManager.CreateCircleByRadius HOLE_CIRCLE_R * Cos(t) / 1000, HOLE_CIRCLE_R * Sin(t) / 1000, 0, HOLE_D / 2000
    Next
End Sub

' ============================================================================= assembly
Private Sub BuildAssembly()
    Dim tmpl As String
    tmpl = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplateAssembly)
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = swApp.NewDocument(tmpl, 0, 0, 0)
    If swModel Is Nothing Then Err.Raise vbObjectError + 1, , "could not create an assembly from the default template"
    Dim swAssy As SldWorks.AssemblyDoc
    Set swAssy = swModel
    Dim opt As Long
    opt = swAddComponentConfigOptions_e.swAddComponentConfigOptions_CurrentSelectedConfig
    ' first component is fixed automatically -> the fixed ring
    swAssy.AddComponent5 PartPath("FixedRing"), opt, "", False, "", 0, 0, 0
    swAssy.AddComponent5 PartPath("OutputRing"), opt, "", False, "", 0, 0, 0
    swAssy.AddComponent5 PartPath("Sun"), opt, "", False, "", 0, 0, 0
    swAssy.AddComponent5 PartPath("Planet"), opt, "", False, "", A1 / 1000, 0, 0
    swAssy.AddComponent5 PartPath("ThinRing"), opt, "", False, "", -ECC / 1000, 0, 0
    swAssy.AddComponent5 PartPath("Carrier"), opt, "", False, "", 0, 0, 0
    swModel.ShowNamedView2 "*Isometric", 7
    swModel.ViewZoomtofit2
    SaveModel swModel, OUT_DIR & "\GearSet.SLDASM"
End Sub

' ============================================================================= gear outlines
' All outlines are closed chains of splines (flanks), arcs (tip and root lands) and radial lines,
' built counter-clockwise, tooth by tooth. Angles in radians, lengths in mm -> metres at the API.

Private Function RootRadiusInternal(Z As Long, x As Double) As Double
    RootRadiusInternal = MODULE_MM * Z / 2 + MODULE_MM * (ADDENDUM + CLEARANCE + x)
End Function

Private Sub AddExternalOutline(swModel As SldWorks.ModelDoc2, Z As Long, x As Double, phaseDeg As Double, cx As Double, cy As Double)
    Dim m As Double, a As Double, r As Double, rb As Double, ra As Double, rf As Double, halfRef As Double
    m = MODULE_MM: a = ALPHA_DEG * PI / 180
    r = m * Z / 2: rb = r * Cos(a)
    ra = r + m * (ADDENDUM + x)
    rf = r - m * (ADDENDUM + CLEARANCE - x)
    halfRef = (m * (PI / 2 + 2 * x * Tan(a)) - BACKLASH / 2) / (2 * r)
    Dim lo As Double: lo = rf: If rb > lo Then lo = rb
    Dim pitch As Double: pitch = 2 * PI / Z
    Dim k As Long, tc As Double, h0 As Double, hTip As Double
    h0 = HalfAngleExt(lo, rb, a, halfRef)
    hTip = HalfAngleExt(ra, rb, a, halfRef)
    If 2 * h0 >= pitch Then Err.Raise vbObjectError + 2, , "teeth overlap at the root (Z=" & Z & ")"
    Dim sm As SldWorks.SketchManager: Set sm = swModel.SketchManager
    For k = 0 To Z - 1
        tc = phaseDeg * PI / 180 + k * pitch
        ' root land from previous tooth to this one
        AddArc sm, cx, cy, rf, tc - pitch + h0, tc - h0
        If rb > rf + 0.000001 Then AddRadialLine sm, cx, cy, rf, tc - h0, rb, tc - h0
        FlankExt sm, cx, cy, lo, ra, rb, a, halfRef, tc, -1
        AddArc sm, cx, cy, ra, tc - hTip, tc + hTip
        FlankExt sm, cx, cy, ra, lo, rb, a, halfRef, tc, 1
        If rb > rf + 0.000001 Then AddRadialLine sm, cx, cy, rb, tc + h0, rf, tc + h0
    Next
End Sub

Private Sub AddInternalOutline(swModel As SldWorks.ModelDoc2, Z As Long, x As Double, phaseDeg As Double, cx As Double, cy As Double)
    Dim m As Double, a As Double, r As Double, rb As Double, ra As Double, rf As Double, halfRef As Double
    m = MODULE_MM: a = ALPHA_DEG * PI / 180
    r = m * Z / 2: rb = r * Cos(a)
    ra = r - m * (ADDENDUM - x)                 ' inner (tip) radius
    rf = r + m * (ADDENDUM + CLEARANCE + x)     ' outer (root) radius
    halfRef = (m * (PI / 2 - 2 * x * Tan(a)) - BACKLASH / 2) / (2 * r)
    If ra < rb Then Err.Raise vbObjectError + 3, , "internal tip circle inside base circle (Z=" & Z & ")"
    Dim pitch As Double: pitch = 2 * PI / Z
    Dim k As Long, tc As Double, hf As Double, hTip As Double
    hf = HalfAngleInt(rf, rb, a, halfRef)
    hTip = HalfAngleInt(ra, rb, a, halfRef)
    If 2 * hf >= pitch Then Err.Raise vbObjectError + 4, , "internal teeth overlap at the root (Z=" & Z & ")"
    Dim sm As SldWorks.SketchManager: Set sm = swModel.SketchManager
    For k = 0 To Z - 1
        tc = phaseDeg * PI / 180 + k * pitch
        AddArc sm, cx, cy, rf, tc - pitch + hf, tc - hf
        FlankInt sm, cx, cy, rf, ra, rb, a, halfRef, tc, -1
        AddArc sm, cx, cy, ra, tc - hTip, tc + hTip
        FlankInt sm, cx, cy, ra, rf, rb, a, halfRef, tc, 1
    Next
End Sub

Private Function HalfAngleExt(rho As Double, rb As Double, a As Double, halfRef As Double) As Double
    Dim ar As Double
    ar = ACos(Min1(rb / rho))
    HalfAngleExt = halfRef + Inv(a) - Inv(ar)
End Function

Private Function HalfAngleInt(rho As Double, rb As Double, a As Double, halfRef As Double) As Double
    Dim ar As Double
    ar = ACos(Min1(rb / rho))
    HalfAngleInt = halfRef - Inv(a) + Inv(ar)
End Function

' flank spline from radius r0 to r1 on the side sgn (-1 = leading edge, +1 = trailing edge) of tooth centre tc
Private Sub FlankExt(sm As SldWorks.SketchManager, cx As Double, cy As Double, r0 As Double, r1 As Double, rb As Double, a As Double, halfRef As Double, tc As Double, sgn As Long)
    Dim pts() As Double, i As Long, rho As Double, th As Double, u As Double
    ReDim pts(3 * N_FLANK - 1)
    For i = 0 To N_FLANK - 1
        u = i / (N_FLANK - 1)
        If r1 > r0 Then
            rho = r0 + (r1 - r0) * u ^ 1.3
        Else
            rho = r1 + (r0 - r1) * (1 - u) ^ 1.3
        End If
        If i = 0 Then rho = r0
        If i = N_FLANK - 1 Then rho = r1
        th = tc + sgn * HalfAngleExt(rho, rb, a, halfRef)
        pts(3 * i) = (cx + rho * Cos(th)) / 1000
        pts(3 * i + 1) = (cy + rho * Sin(th)) / 1000
        pts(3 * i + 2) = 0
    Next
    Dim v As Variant: v = pts
    Dim seg As SldWorks.SketchSegment
    Set seg = sm.CreateSpline2((v), False)
    If seg Is Nothing Then Err.Raise vbObjectError + 9, , "CreateSpline2 failed"
End Sub

Private Sub FlankInt(sm As SldWorks.SketchManager, cx As Double, cy As Double, r0 As Double, r1 As Double, rb As Double, a As Double, halfRef As Double, tc As Double, sgn As Long)
    Dim pts() As Double, i As Long, rho As Double, th As Double, u As Double
    ReDim pts(3 * N_FLANK - 1)
    For i = 0 To N_FLANK - 1
        u = i / (N_FLANK - 1)
        If r1 > r0 Then
            rho = r0 + (r1 - r0) * u ^ 1.3
        Else
            rho = r1 + (r0 - r1) * (1 - u) ^ 1.3
        End If
        If i = 0 Then rho = r0
        If i = N_FLANK - 1 Then rho = r1
        th = tc + sgn * HalfAngleInt(rho, rb, a, halfRef)
        pts(3 * i) = (cx + rho * Cos(th)) / 1000
        pts(3 * i + 1) = (cy + rho * Sin(th)) / 1000
        pts(3 * i + 2) = 0
    Next
    Dim v As Variant: v = pts
    Dim seg As SldWorks.SketchSegment
    Set seg = sm.CreateSpline2((v), False)
    If seg Is Nothing Then Err.Raise vbObjectError + 9, , "CreateSpline2 failed"
End Sub

Private Sub AddArc(sm As SldWorks.SketchManager, cx As Double, cy As Double, r As Double, t0 As Double, t1 As Double)
    If t1 - t0 < 0.0000001 Then Exit Sub
    Dim seg As SldWorks.SketchSegment
    Set seg = sm.CreateArc(cx / 1000, cy / 1000, 0, (cx + r * Cos(t0)) / 1000, (cy + r * Sin(t0)) / 1000, 0, _
                           (cx + r * Cos(t1)) / 1000, (cy + r * Sin(t1)) / 1000, 0, gArcCCW)
End Sub

Private Sub AddRadialLine(sm As SldWorks.SketchManager, cx As Double, cy As Double, r0 As Double, t0 As Double, r1 As Double, t1 As Double)
    Dim seg As SldWorks.SketchSegment
    Set seg = sm.CreateLine((cx + r0 * Cos(t0)) / 1000, (cy + r0 * Sin(t0)) / 1000, 0, _
                            (cx + r1 * Cos(t1)) / 1000, (cy + r1 * Sin(t1)) / 1000, 0)
End Sub

' ============================================================================= SolidWorks helpers
Private Function NewPart() As SldWorks.ModelDoc2
    Dim tmpl As String
    tmpl = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
    Set NewPart = swApp.NewDocument(tmpl, 0, 0, 0)
    If NewPart Is Nothing Then Err.Raise vbObjectError + 5, , "could not create a part from the default template"
End Function

' select the first reference plane (Front Plane in any language) and open a sketch on it
Private Sub StartSketch(swModel As SldWorks.ModelDoc2)
    Dim swFeat As SldWorks.Feature
    Set swFeat = swModel.FirstFeature
    Do While Not swFeat Is Nothing
        If swFeat.GetTypeName2 = "RefPlane" Then Exit Do
        Set swFeat = swFeat.GetNextFeature
    Loop
    If swFeat Is Nothing Then Err.Raise vbObjectError + 6, , "no reference plane found"
    swModel.ClearSelection2 True
    swFeat.Select2 False, 0
    swModel.SketchManager.InsertSketch True
    swModel.SketchManager.AddToDB = True
    swModel.SketchManager.DisplayWhenAdded = False
End Sub

' close the active sketch and extrude it: depth and offset in mm, measured towards +Z (reverse: towards -Z)
Private Sub Extrude(swModel As SldWorks.ModelDoc2, depthMM As Double, offsetMM As Double, reverse As Boolean)
    Dim swSketch As SldWorks.Sketch
    Set swSketch = swModel.SketchManager.ActiveSketch
    swModel.SketchManager.AddToDB = False
    swModel.SketchManager.DisplayWhenAdded = True
    swModel.SketchManager.InsertSketch True
    Dim swFeat As SldWorks.Feature
    Set swFeat = swSketch
    swModel.ClearSelection2 True
    swFeat.Select2 False, 0
    Dim dirFlag As Boolean, startCond As Long, offFlip As Boolean
    dirFlag = gDirFlip
    If reverse Then dirFlag = Not dirFlag
    offFlip = gOffFlip
    If reverse Then offFlip = Not offFlip
    If offsetMM > 0.0000001 Then
        startCond = swStartConditions_e.swStartOffset
    Else
        startCond = swStartConditions_e.swStartSketchPlane
    End If
    Dim f As SldWorks.Feature
    Set f = swModel.FeatureManager.FeatureExtrusion3(True, False, dirFlag, _
            swEndConditions_e.swEndCondBlind, swEndConditions_e.swEndCondBlind, depthMM / 1000, 0, _
            False, False, False, False, 0, 0, False, False, False, False, True, True, True, _
            startCond, offsetMM / 1000, offFlip)
    If f Is Nothing Then Err.Raise vbObjectError + 7, , "extrusion failed (sketch not closed?)"
End Sub

Private Sub Finish(swModel As SldWorks.ModelDoc2, partName As String, Z As Long, x As Double)
    On Error Resume Next
    Dim cp As SldWorks.CustomPropertyManager
    Set cp = swModel.Extension.CustomPropertyManager("")
    cp.Add3 "GearSet", swCustomInfoType_e.swCustomInfoText, SET_NAME, swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
    cp.Add3 "Module", swCustomInfoType_e.swCustomInfoText, CStr(MODULE_MM), swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
    cp.Add3 "Teeth", swCustomInfoType_e.swCustomInfoText, CStr(Z), swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
    cp.Add3 "PressureAngle", swCustomInfoType_e.swCustomInfoText, CStr(ALPHA_DEG), swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
    cp.Add3 "ProfileShift", swCustomInfoType_e.swCustomInfoText, CStr(x), swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
    cp.Add3 "Ratio", swCustomInfoType_e.swCustomInfoText, "-1560695/2952 = -528.690718", swCustomPropertyAddOption_e.swCustomPropertyReplaceValue
    Dim eq As SldWorks.EquationMgr
    Set eq = swModel.GetEquationMgr
    eq.Add2 -1, """Module"" = " & Replace(CStr(MODULE_MM), ",", "."), True
    eq.Add2 -1, """Teeth"" = " & Z, True
    eq.Add2 -1, """FaceWidth"" = " & Replace(CStr(FACE_WIDTH), ",", "."), True
    On Error GoTo 0
    swModel.ForceRebuild3 False
    swModel.ShowNamedView2 "*Isometric", 7
    swModel.ViewZoomtofit2
    SaveModel swModel, PartPath(partName)
End Sub

Private Function PartPath(partName As String) As String
    PartPath = OUT_DIR & "\" & partName & ".SLDPRT"
End Function

Private Sub SaveModel(swModel As SldWorks.ModelDoc2, path As String)
    Dim lErr As Long, lWarn As Long, ok As Boolean
    ok = swModel.Extension.SaveAs(path, swSaveAsVersion_e.swSaveAsCurrentVersion, _
                                  swSaveAsOptions_e.swSaveAsOptions_Silent, Nothing, lErr, lWarn)
    If Not ok Then Err.Raise vbObjectError + 8, , "SaveAs failed for " & path & " (error " & lErr & ")"
End Sub

Private Sub EnsureFolder(path As String)
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    If fso.FolderExists(path) Then Exit Sub
    Dim parent As String
    parent = fso.GetParentFolderName(path)
    If Len(parent) > 0 Then EnsureFolder parent
    fso.CreateFolder path
End Sub

' Determine on a throw-away part which flag values make (1) blind extrusions grow towards +Z,
' (2) start offsets move towards +Z and (3) CreateArc run counter-clockwise.
Private Sub Calibrate()
    gDirFlip = False: gOffFlip = False: gArcCCW = 1
    Dim swModel As SldWorks.ModelDoc2
    Set swModel = NewPart()
    ' arc orientation
    StartSketch swModel
    Dim seg As SldWorks.SketchSegment
    Set seg = swModel.SketchManager.CreateArc(0, 0, 0, 0.01, 0, 0, 0, 0.01, 0, 1)
    Dim swArc As SldWorks.SketchArc
    Set swArc = seg
    Dim nv As Variant
    nv = swArc.GetNormalVector
    If nv(2) < 0 Then gArcCCW = -1
    swModel.SketchManager.AddToDB = False
    swModel.SketchManager.InsertSketch True
    ' extrusion direction
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, 0.005
    Extrude swModel, 10, 0, False
    Dim box As Variant
    box = BodyBox(swModel)
    If box(5) < 0.001 Then gDirFlip = True
    ' offset direction
    StartSketch swModel
    swModel.SketchManager.CreateCircleByRadius 0, 0, 0, 0.003
    Extrude swModel, 2, 20, False
    box = BodyBox(swModel)
    If box(2) < -0.005 Then gOffFlip = True
    swApp.CloseDoc swModel.GetTitle
End Sub

Private Function BodyBox(swModel As SldWorks.ModelDoc2) As Variant
    Dim swPart As SldWorks.PartDoc
    Set swPart = swModel
    Dim bodies As Variant, b As Variant, bb As Variant
    Dim res(5) As Double
    res(0) = 1E+99: res(1) = 1E+99: res(2) = 1E+99: res(3) = -1E+99: res(4) = -1E+99: res(5) = -1E+99
    bodies = swPart.GetBodies2(swBodyType_e.swSolidBody, True)
    For Each b In bodies
        bb = b.GetBodyBox
        If bb(0) < res(0) Then res(0) = bb(0)
        If bb(1) < res(1) Then res(1) = bb(1)
        If bb(2) < res(2) Then res(2) = bb(2)
        If bb(3) > res(3) Then res(3) = bb(3)
        If bb(4) > res(4) Then res(4) = bb(4)
        If bb(5) > res(5) Then res(5) = bb(5)
    Next
    BodyBox = res
End Function

' ============================================================================= maths
Private Function Inv(a As Double) As Double
    Inv = Tan(a) - a
End Function

Private Function ACos(x As Double) As Double
    If x >= 1 Then
        ACos = 0
    ElseIf x <= -1 Then
        ACos = PI
    Else
        ACos = Atn(-x / Sqr(-x * x + 1)) + 2 * Atn(1)
    End If
End Function

Private Function Min1(x As Double) As Double
    If x > 1 Then Min1 = 1 Else Min1 = x
End Function
